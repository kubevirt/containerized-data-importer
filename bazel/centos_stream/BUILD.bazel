# Selects the el9 or el10 RPM trees from //rpm; --config=cs10 picks el10.
# Hand-written, not generated by bazeldnf.
package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_cs10",
    define_values = {"centos_stream_version": "10"},
)

alias(
    name = "centos_base_x86_64",
    actual = select({
        ":is_cs10": "//rpm:centos_base_x86_64_cs10",
        "//conditions:default": "//rpm:centos_base_x86_64",
    }),
)

alias(
    name = "centos_base_aarch64",
    actual = select({
        ":is_cs10": "//rpm:centos_base_aarch64_cs10",
        "//conditions:default": "//rpm:centos_base_aarch64",
    }),
)

